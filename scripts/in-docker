#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
IMAGE=${GO_IMAGE:-golang:1.27.4-bookworm}
NETWORK=${GO_DOCKER_NETWORK:-bridge}
CACHE_ROOT=/tmp/opencode/go-shortener-cache
mkdir -p "$CACHE_ROOT/gopath" "$CACHE_ROOT/gocache"
docker run --rm \
  --network "$NETWORK" \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp -e GOCACHE=/tmp/gocache -e GOPATH=/tmp/gopath \
  -e INTEGRATION_DATABASE_URL -e INTEGRATION_REDIS_ADDR -e INTEGRATION_REDIS_PASSWORD \
  -v "$CACHE_ROOT/gopath:/tmp/gopath" -v "$CACHE_ROOT/gocache:/tmp/gocache" \
  -v "$ROOT:/workspace" -w /workspace \
  "$IMAGE" sh -c 'go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0 && export PATH="$PATH:/tmp/gopath/bin" && exec make "$@"' -- "$@"
