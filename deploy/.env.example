# Copy to deploy/.env and replace every CHANGE_ME value with a unique value.
# Generate secrets with: openssl rand -hex 32
GO_SHORTENER_VERSION=latest
APP_PORT=8080
BASE_URL=https://short.example.com
API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
POSTGRES_USER=shortener
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
DATABASE_URL=postgres://shortener:CHANGE_ME_generate_with_openssl_rand_hex_32@postgres:5432/shortener?sslmode=disable
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
REDIS_URL=redis://:CHANGE_ME_generate_with_openssl_rand_hex_32@redis:6379/0
RATE_LIMIT=10
RATE_WINDOW=1m
