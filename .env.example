APP_ADDR=:8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener?sslmode=disable
REDIS_URL=redis://localhost:6379
# Legacy deployments may use REDIS_ADDR and REDIS_PASSWORD instead.
API_KEY=replace-this-development-key
RATE_LIMIT=10
RATE_WINDOW=1m
CLICK_WORKERS=2
CLICK_BUFFER=2048
CLICK_BATCH=100
LOG_LEVEL=info
